{
  "name": "@streetlifting/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed:root": "tsx scripts/seed-root.ts",
    "seed:disciplines": "tsx scripts/seed-disciplines.ts",
    "seed:countries": "tsx scripts/seed-countries.ts",
    "seed:rf-regions": "tsx scripts/seed-rf-regions.ts",
    "seed:rf-cities": "tsx scripts/seed-rf-cities.ts",
    "seed:lookup-values": "tsx scripts/seed-lookup-values.ts",
    "seed:references": "pnpm seed:countries && pnpm seed:rf-regions && pnpm seed:rf-cities && pnpm seed:lookup-values",
    "seed:launch": "pnpm seed:disciplines && pnpm seed:references && pnpm seed:root",
    "seed:federation-user": "tsx scripts/seed-federation-user.ts",
    "smoke:isf": "tsx scripts/smoke-isf-integration.ts",
    "smoke:pilot": "tsx scripts/smoke-pilot-flow.ts",
    "clean": "rimraf dist .turbo",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.3.1",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^8.55.2",
    "@streetlifting/domain": "workspace:*",
    "@vercel/blob": "^2.8.0",
    "argon2": "^0.41.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^4.0.2",
    "jose": "^5.10.0",
    "nodemailer": "^9.1.1",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "redis": "4.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "tsx": "^4.23.13",
    "vitest": "^3.2.7"
  }
}
