NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://streetlifting:streetlifting@localhost:55432/streetlifting?schema=public

# Comma-separated list. Never use `*` here for credentialed routes.
CORS_ORIGIN=http://localhost:1420

# JWT — random ≥ 32 chars. Generate with: `openssl rand -base64 48`
# REQUIRED — server refuses to issue tokens if missing or too short.
JWT_SECRET=

# Logging
LOG_LEVEL=debug
SENTRY_DSN=

# Mail delivery for federation test emails.
# Option A: POST JSON to an internal/third-party mailer endpoint.
MAILER_ENDPOINT=
MAILER_ENDPOINT_TOKEN=
# Option B: SMTP delivery via nodemailer.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAILER_FROM="Streetlifting App <no-reply@streetlifting.app>"
MAILER_TIMEOUT_MS=10000

# Telegram bot notifications. Leave empty to keep registration notifications
# queued in the DB without delivery. Use Telegram's webhook secret header when
# exposing /telegram/webhook publicly.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Global operational API limit. Auth routes keep stricter per-route limits.
RATE_LIMIT_MAX=600
RATE_LIMIT_TIME_WINDOW=1 minute

# Tauri updater signing key — NEVER paste here, only in CI secret store.
# TAURI_SIGNING_PRIVATE_KEY=

# Root user (for `pnpm --filter=@streetlifting/api seed:root`).
# Set both, then run the seed once. Re-running rotates the password.
ROOT_EMAIL=
ROOT_PASSWORD=
ROOT_DISPLAY_NAME=Platform Admin
