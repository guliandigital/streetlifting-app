NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Postgres. Local development uses a Neon development branch (no Docker):
#   vercel env pull apps/api/.env --environment=development
# or paste the branch connection string here. Pooled ("-pooler") URLs are
# detected automatically and get `pgbouncer=true` appended for Prisma.
DATABASE_URL=
# Direct (unpooled) URL for `prisma migrate`. Optional locally; on Vercel the
# Neon integration provides DATABASE_URL_UNPOOLED.
DATABASE_URL_UNPOOLED=

# Comma-separated list. Never use `*` here for credentialed routes.
CORS_ORIGIN=http://localhost:1420

# JWT — random ≥ 32 chars. Generate with: `openssl rand -base64 48`
# REQUIRED — server refuses to issue tokens if missing or too short.
JWT_SECRET=

# File storage for athlete photos, federation and passport attachments.
#   fs          — local directory (STORAGE_DIR, default ./storage); dev and tests
#   vercel-blob — private Vercel Blob store; requires BLOB_READ_WRITE_TOKEN
# Defaults to vercel-blob when BLOB_READ_WRITE_TOKEN is set, otherwise fs.
STORAGE_DRIVER=
STORAGE_DIR=
BLOB_READ_WRITE_TOKEN=

# ISF ID signed SSO assertions. Keep disabled until the independent ISF ID
# issuer and its JWKS endpoint are provisioned. Tokens are never accepted from
# query parameters.
ISF_ID_ENABLED=false
ISF_ID_ISSUER=
ISF_ID_AUDIENCE=streetlifting-api
ISF_ID_JWKS_URL=

# Logging
LOG_LEVEL=debug
SENTRY_DSN=

# Mail delivery for federation test emails.
# Option A: POST JSON to an internal/third-party mailer endpoint.
MAILER_ENDPOINT=
MAILER_ENDPOINT_TOKEN=
# Option B: SMTP delivery via nodemailer.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAILER_FROM="Streetlifting App <no-reply@streetlifting.app>"
MAILER_TIMEOUT_MS=10000

# Global operational API limit. Auth routes keep stricter per-route limits.
# Counters are per process instance (per function instance on Vercel).
RATE_LIMIT_MAX=600
RATE_LIMIT_TIME_WINDOW=1 minute

# WebSocket live updates need a long-lived server; they are skipped
# automatically on Vercel (clients fall back to HTTP polling). Set to `false`
# to disable elsewhere. Optional Redis Pub/Sub backplane for multi-process
# self-hosted deployments only.
LIVE_UPDATES_WS=
REDIS_URL=

# ISF webhook outbox delivery. Self-hosted: interval timer. Vercel: cron in
# apps/api/vercel.json calls /internal/cron/isf-outbox with this bearer secret.
ISF_WEBHOOK_DELIVERY_INTERVAL_MS=
CRON_SECRET=

# Tauri updater signing key — NEVER paste here, only in CI secret store.
# TAURI_SIGNING_PRIVATE_KEY=

# Root user (for `pnpm --filter=@streetlifting/api seed:root`).
# Set both, then run the seed once. Re-running rotates the password.
ROOT_EMAIL=
ROOT_PASSWORD=
ROOT_DISPLAY_NAME=Platform Admin
