NODE_ENV=development
HOST=127.0.0.1
PORT=3100

# ISF ID issuer. Use HTTPS outside localhost. Generate an RSA private key
# outside this file and provision it through the environment or secret store.
ISF_ID_ISSUER=http://127.0.0.1:3100
ISF_ID_KEY_ID=isf-id-local-20260722
ISF_ID_PRIVATE_KEY=
ISF_ID_PRIVATE_KEY_PATH=
ISF_ID_ALLOWED_AUDIENCES=streetlifting-api,streetlifting-pro
ISF_ID_RELYING_PARTIES=streetlifting-api=https://streetlifting.app/isf-id,streetlifting-pro=https://streetlifting.pro/isf-id/callback/
ISF_ID_ASSERTION_TTL_SECONDS=120

# Internal only. This authorizes a trusted account/control-plane service to
# request a signed launch assertion; it must never be sent to a browser.
ISF_ID_ISSUER_SERVICE_TOKEN=

# Passwordless login. No code is returned by the API; delivery fails closed
# until one delivery option and both HMAC secrets are configured.
ISF_ID_CHALLENGE_SECRET=
ISF_ID_SESSION_SECRET=
ISF_ID_MAILER_ENDPOINT=
ISF_ID_MAILER_TOKEN=
ISF_ID_SMTP_HOST=
ISF_ID_SMTP_PORT=465
ISF_ID_SMTP_SECURE=true
ISF_ID_SMTP_USER=
ISF_ID_SMTP_PASSWORD=
ISF_ID_MAILER_FROM="ISF ID <no-reply@streetlifting.app>"

# Dedicated ISF ID database; never point this at the Streetlifting App DB.
DATABASE_URL=postgresql://isf_id:<password>@127.0.0.1:5432/isf_id?schema=public
