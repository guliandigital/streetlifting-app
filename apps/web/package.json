{
  "name": "@streetlifting/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "e2e:auth": "node scripts/save-manual-auth-state.mjs",
    "e2e:auth:manual": "node scripts/save-manual-auth-state.mjs",
    "e2e:ui": "playwright test --ui",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@sentry/react": "^8.45.1",
    "@streetlifting/domain": "workspace:*",
    "@streetlifting/ui": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "^1.91.0",
    "i18next": "^24.1.0",
    "i18next-browser-languagedetector": "^8.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.2.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tanstack/router-devtools": "^1.91.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0-beta.7",
    "@tailwindcss/vite": "^4.0.0-beta.7",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
