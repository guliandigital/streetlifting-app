{
  "name": "streetlifting-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Streetlifting & weighted calisthenics competition platform — web-first",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:turbo": "pnpm build:packages && turbo run dev --parallel",
    "build:packages": "pnpm --filter=@streetlifting/domain build",
    "build": "turbo run build",
    "release:check": "pnpm build:packages && pnpm --filter=@streetlifting/api db:generate && pnpm --filter=@streetlifting/api db:validate && pnpm --filter=@streetlifting/isf-id db:generate && pnpm --filter=@streetlifting/isf-id db:validate && pnpm lint && pnpm typecheck && pnpm test && pnpm --filter=@streetlifting/api build && pnpm --filter=@streetlifting/web build && pnpm --filter=@streetlifting/isf-id build",
    "release:migrate": "pnpm --filter=@streetlifting/api db:deploy",
    "release:seed": "pnpm --filter=@streetlifting/api seed:launch",
    "release:smoke": "pnpm --filter=@streetlifting/api smoke:pilot",
    "release:smoke:isf": "pnpm --filter=@streetlifting/api smoke:isf",
    "e2e:web": "pnpm --filter=@streetlifting/web e2e",
    "check:personal-data:db": "node scripts/check-personal-data-db.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml,css,html}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "lefthook install"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ggr8-5vv4-36mx"
      ]
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.3",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "lefthook": "^1.13.6",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  }
}
