NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://streetlifting:<password>@127.0.0.1:5432/streetlifting?schema=public
CORS_ORIGIN=https://streetlifting.app,https://www.streetlifting.app
JWT_SECRET=<48+ bytes random base64>

# ISF ID SSO. Enable only after the independent issuer and JWKS rotation path
# have been verified in staging.
ISF_ID_ENABLED=false
ISF_ID_ISSUER=
ISF_ID_AUDIENCE=streetlifting-api
ISF_ID_JWKS_URL=
LOG_LEVEL=info
SENTRY_DSN=
RATE_LIMIT_MAX=120
RATE_LIMIT_TIME_WINDOW=1 minute

# Redis Pub/Sub for WebSocket updates across multiple API processes.
# Keep empty only for a single-process deployment.
REDIS_URL=redis://127.0.0.1:6379
